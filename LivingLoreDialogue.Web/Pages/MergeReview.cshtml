@page
<section class="page">
    <h2>Character Merge Review</h2>
    <p class="page-intro">Characters that share the same name appear here as duplicate groups. Pick which row to keep and
       merge the rest — their lore, sources, and dialogue are consolidated under the kept character.</p>
    <p id="merge-summary" class="status"></p>
    <div id="merge-groups" class="columns"></div>
</section>

@section Scripts {
<script>
loadMergeReview();
</script>
}

@page
<section class="page">
    <h2>Codex Board</h2>
    <p class="page-intro">Watch the valley ledger, character lore, and generated dialogue threads from one enchanted control board.</p>

    <div class="dashboard-grid">
        <section class="card span-6" id="openai-panel">
            <div class="card-header">
                <h3>Oracle Connection</h3>
                <span class="chip">Model Sigil</span>
            </div>
            <div class="metrics" id="openai-status"></div>
            <div class="action-row">
                <label for="openai-model-select">Model</label>
                <select id="openai-model-select"></select>
                <button id="openai-model-apply" class="secondary">Apply</button>
                <button id="openai-recheck" class="secondary">Re-check</button>
                <span id="openai-model-result" class="status"></span>
            </div>
        </section>

        <section class="span-6">
            <div class="metrics" id="metrics"></div>
        </section>

        <section class="card span-6">
            <h3>Recent Spoken Lines</h3>
            <div id="dialogue-cards" class="dialogue-list"></div>
        </section>

        <section class="card span-6">
            <h3>Ledger Snapshot</h3>
            <div id="dashboard-charts" class="chart-bars"></div>
        </section>

        <section class="card span-12">
            <div class="panel-header">
                <h3>Chronicle Timeline</h3>
                <span class="chip">Recent Lore Changes</span>
            </div>
            <table id="changes"></table>
        </section>
    </div>
</section>

@section Scripts {
<script>
loadDashboard();
loadOpenAiPanel();
</script>
}
